{
  "vim": {
    "default_mode": "insert"
  },
  "cursor_animation": {
    "enabled": true
  },
  "markdown_preview": {
    "code_font_family": "JetBrainsMono Nerd Font",
    "font_family": "JetBrainsMono Nerd Font"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "proxy": "",
  "vim_mode": false,
  "base_keymap": "VSCode",
  "accessible_mode": false,
  "helix_mode": false,
  "cli_default_open_behavior": "existing_window",
  "theme": "Catppuccin Night",
  "icon_theme": "Catppuccin Mocha",
  "theme_overrides": {
    "Catppuccin Night": {
      "border.variant": "#100c1d",
      "border": "#100c1d",
      "title_bar.background": "#100c1d",
      "panel.background": "#100c1d",
      "panel.focused_border": "#100c1d",
      "terminal.foreground": "#100c1d",
      "terminal.background": "#100c1d",
      "terminal.dim_foreground": "#100c1d",
      "border.transparent": "#100c1d",
      "border.disabled": "#100c1d",
      "border.selected": "#100c1d",
      "border.focused": "#494655",
      "scrollbar.thumb.hover_background": "#494655",
      "scrollbar.thumb.active_background": "#494655",
      "scrollbar.thumb.background": "#494655",
      "scrollbar.thumb.border": "#100c1d",
      "players": [
        {
          "cursor": "#c2c3c6",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "project_panel": {
    "default_width": 350,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16.5,
  "when_closing_with_no_tabs": "keep_window_open",
  "restore_on_startup": "last_session",
  "cursor_blink": false,
  "window_decorations": "client",
  "disable_ai": true,
  "middle_click_paste": false,
  "hide_mouse":"on_typing_and_action",
  "terminal": {
    "cursor_shape": "block"
  },
  "lsp_document_colors": "inlay",
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "enable_language_server": true,
  "languages": {
      "Nim": {
        "enable_language_server": true,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "nph",
            "arguments": ["-"]
          }
        }
      }
    },
    "lsp": {
      "nim": {
        "binary": {
          "path": "/home/slib/.nimble/bin/nimlangserver",
          "args": []
        }
      }
    }
}
