Window "power_menu" {
    monitor = 0
    geometry = {
        x = "0%"
        y = "0%"
        width = "100%"
        height = "100%"
        anchor = "center"
    }
    stacking = "overlay"
    exclusive = false

    EventBox {
        class = "backdrop"
        hexpand = true
        vexpand = true
        onclick = "~/.local/bin/ewwii close power_menu"

        EventBox {
            class = "pw-menu"
            halign = "center"
            valign = "center"
            onclick = "true"
            width = "750px"
            height = "320px"

            Box {
                orientation = "horizontal"
                spacing = 4

                EventBox {
                    class = "power-btn"
                    onclick = "loginctl poweroff"

                    Box {
                        orientation = "vertical"

                        Label {
                            class = "pw-txt"
                            text = "⏻"
                        }
                        Label {
                            text = "Shutdown"
                        }
                    }
                }

                EventBox {
                    class = "power-btn"
                    onclick = "niri msg action quit --skip-confirmation"

                    Box {
                        orientation = "vertical"

                        Label {
                            class = "pw-txt"
                            text = "󰈆"
                        }
                        Label {
                            text = "Logout"
                        }
                    }
                }

                EventBox {
                    class = "power-btn"
                    onclick = "loginctl suspend"

                    Box {
                        orientation = "vertical"

                        Label {
                            class = "pw-txt"
                            text = "󰒲"
                          }
			                  Label {
			                      text = "Suspend"
			                    }
                      }
                  }

                EventBox {
                    class = "power-btn"
                    onclick = "loginctl reboot"

                    Box {
                        orientation = "vertical"

                        Label {
                            class = "pw-txt"
                            text = ""
                        }
                        Label {
                            text = "Reboot"
                        }
                    }
                }
            }
        }
    }
}
